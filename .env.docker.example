# ==========================================================
# SPARTAN SUPLEMENTOS BOLIVIA — PLANTILLA DE CONFIGURACIÓN DOCKER
# ==========================================================
# Copie este archivo a .env.docker y defina contraseñas seguras para producción.

# Base de datos PostgreSQL
POSTGRES_DB=spartan_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=cambia_esta_contrasena_segura_2026!
POSTGRES_PORT=5432

# URL de conexión interna entre contenedores Docker
DATABASE_URL=postgresql+asyncpg://postgres:cambia_esta_contrasena_segura_2026!@db:5432/spartan_db

# Seguridad OAuth2 y JWT (Generar con: openssl rand -hex 32)
SECRET_KEY=genera_una_clave_secreta_de_32_caracteres_o_mas_hex
ACCESS_TOKEN_EXPIRE_MINUTES=60
ALGORITHM=HS256
ADMIN_INITIAL_PASSWORD=cambia_esta_contrasena_admin!

# Microservicio IA y Roboflow
ROBOFLOW_API_KEY=tu_api_key_de_roboflow
IA_PORT=8001

# Frontend Vite
VITE_API_URL=http://localhost:8000
FRONTEND_PORT=5173
