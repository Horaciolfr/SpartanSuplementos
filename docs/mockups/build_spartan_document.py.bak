    matrix_rows = [
        ("01. Landing & Catálogo Dinámico", "Hero panorámico con buscador omnicanal, banners promocionales y grilla de productos a 4 columnas con hover 3D.", "Vista vertical a 1 columna con navegación compacta, menú hamburguesa táctil y tarjetas de producto optimizadas.", "Ocultamiento de textos de marketing secundarios, condensación de badges y barra de navegación inferior fija."),
        ("02. Biometría & Escáner IA 3D", "Visor dual paralelo: Video y superposición de 33 landmarks a la izquierda (7 cols) y diagnóstico médico a la derecha (5 cols).", "Disposición secuencial vertical: Visor de cámara en 4:3 en parte superior, botonera compacta y tarjeta de somatotipo abajo.", "Rejilla colapsable con scroll suave, botones táctiles de 48px y carrusel de pestañas deslizables con swipe táctil."),
        ("03. Antropometría & Planes Dieta", "Desglose completo en tarjetas Bento: Calorías totales, gráficos radiales de macros, hidratación y lista de suplementos.", "Control segmentado (Tabs) para alternar entre Macronutrientes, Plan de Comidas y Suplementación recomendada.", "Agrupación en acordeones colapsables para no saturar el espacio vertical y tarjetas táctiles con resumen."),
        ("04. Prescripción & Cross-Selling", "Panel comparativo de reglas de decisión CART, afinidades de producto (Top-3) y botones de compra directa.", "Tarjetas de recomendación deslizables horizontalmente con indicador de stock garantizado y botón de añadir.", "Reducción de texto explicativo a badges de afinidad y conversión de grilla en carrusel swipeable."),
        ("05. Punto de Venta (POS) & Kárdex", "Catálogo central interactivo con filtros por categoría y barra lateral fija de orden con cálculo automático de cambio.", "Catálogo de productos táctil con barra flotante inferior persistente ('VER ORDEN ->') y modal de cobro drawer.", "Panel lateral transformado en botón flotante ergonómico y resumen de venta desplegable desde el borde inferior."),
        ("06. Dashboard Predictivo Demanda", "Dashboard gerencial multidivisión con gráficos de serie temporal, banda de confianza al 95% y selector de sucursales.", "Tarjetas resumen apiladas con métricas clave (R², Facturación, Unidades) y selector de sucursales en dropdown.", "Gráficos SVG interactivos adaptados con scroll horizontal y tooltips táctiles con retardo táctil ajustado."),
        ("07. Directorio de Clientes ERP", "Tabla de datos de alta densidad con filtros por somatotipo, ordenamiento por columnas y acciones de inspección clínica.", "Tarjetas individuales de cliente con indicador de somatotipo en píldora y botón de visualización rápida.", "Conversión integral de tabla horizontal en tarjetas apiladas con información esencial y modal de detalle."),
        ("08. Autenticación & Control RBAC", "Ventana modal centrada con efectos de glassmorphism, halos ambientales y selector de credenciales de demo.", "Formulario vertical fluido a pantalla completa, adaptado al teclado virtual del smartphone.", "Márgenes y paddings optimizados para evitar saltos de pantalla indeseados al desplegar el teclado en iOS/Android.")
    ]

