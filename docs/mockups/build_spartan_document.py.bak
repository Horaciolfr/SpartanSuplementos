        r.font.size = Pt(9.5)
        r.font.color.rgb = RGBColor(255, 255, 255)

    services_data = [
        ("Frontend SPA", "React 18 + TypeScript + Vite + Tailwind CSS + Framer Motion + Sonner", "http://localhost:5173", "Interfaz de usuario multiplataforma reactiva, renderizado ágil de componentes y gestión de estado."),
        ("Backend ERP & API Gateway", "FastAPI (Asíncrono) + SQLAlchemy 2.0 + Pydantic V2 + JWT Bcrypt", "http://localhost:8000", "Lógica de negocio transaccional, seguridad RBAC, emisión de órdenes y orquestación REST."),
        ("Servicio IA & Visión 3D", "Google MediaPipe Pose 3D + Scikit-Learn (Random Forest 150) + Heath-Carter", "http://localhost:8001", "Extracción de 33 landmarks óseos tridimensionales, validación postural y clasificación somatotípica."),
        ("Base de Datos ACID", "PostgreSQL 16 (Esquemas desacoplados: erp, ia, parametros)", "localhost:5433", "Persistencia ACID, control de concurrencia mediante Row-Level Locking y registro Kárdex físico.")
    ]

