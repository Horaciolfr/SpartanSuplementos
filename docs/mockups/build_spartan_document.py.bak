import os
import sys
import docx
from docx.shared import Inches, Pt, RGBColor
from docx.enum.text import WD_ALIGN_PARAGRAPH
from docx.enum.table import WD_TABLE_ALIGNMENT
from docx.oxml import parse_xml
from docx.oxml.ns import nsdecls, qn

def create_spartan_report():
    base_dir = r"e:\PROYECTO DE GRADO\nuevo proyecto\Proyecto SS\docs\mockups"
    capturas_dir = os.path.join(base_dir, "capturas_reales")
    output_docx = os.path.join(base_dir, "INFORME_MOCKUPS_Y_SISTEMA_REAL_SPARTAN.docx")

    doc = docx.Document()

    # --- CONFIGURACIÓN DE PÁGINA (Letter, Márgenes de 0.75 in / 1.9 cm) ---
    for section in doc.sections:
        section.page_width = Inches(8.5)
        section.page_height = Inches(11.0)
        section.top_margin = Inches(0.75)
        section.bottom_margin = Inches(0.75)
        section.left_margin = Inches(0.75)
        section.right_margin = Inches(0.75)
        section.different_first_page_header_footer = True

    # --- FUNCIONES AUXILIARES XML PARA ESTILOS PROFESIONALES ---
    def set_cell_background(cell, fill_hex):
        tcPr = cell._tc.get_or_add_tcPr()
        for shd in tcPr.findall(qn('w:shd')):
            tcPr.remove(shd)
        tcPr.append(parse_xml(f'<w:shd {nsdecls("w")} w:fill="{fill_hex}"/>'))

    def set_cell_margins(cell, top=120, bottom=120, left=160, right=160):
        tcPr = cell._tc.get_or_add_tcPr()
        for mar in tcPr.findall(qn('w:tcMar')):
            tcPr.remove(mar)
        tcPr.append(parse_xml(
            f'<w:tcMar {nsdecls("w")}>'
            f'<w:top w:w="{top}" w:type="dxa"/>'
            f'<w:bottom w:w="{bottom}" w:type="dxa"/>'
            f'<w:left w:w="{left}" w:type="dxa"/>'
            f'<w:right w:w="{right}" w:type="dxa"/>'
            f'</w:tcMar>'
        ))

    def set_cell_borders(cell, top=None, bottom=None, left=None, right=None):
        tcPr = cell._tc.get_or_add_tcPr()
        for b in tcPr.findall(qn('w:tcBorders')):
            tcPr.remove(b)
        borders_xml = f'<w:tcBorders {nsdecls("w")}>'
        for side, spec in [('top', top), ('left', left), ('bottom', bottom), ('right', right)]:
            if spec:
                val, sz, space, color = spec
                borders_xml += f'<w:{side} w:val="{val}" w:sz="{sz}" w:space="{space}" w:color="{color}"/>'
            else:
                borders_xml += f'<w:{side} w:val="none"/>'
        borders_xml += '</w:tcBorders>'
        tcPr.append(parse_xml(borders_xml))

    def add_page_number_field(run):
        fldSimple = parse_xml(r'<w:fldSimple %s w:instr="PAGE"/>' % nsdecls('w'))
        run._r.append(fldSimple)

    def add_numpages_field(run):
        fldSimple = parse_xml(r'<w:fldSimple %s w:instr="NUMPAGES"/>' % nsdecls('w'))
        run._r.append(fldSimple)

    # --- PALETA DE COLORES CORPORATIVOS Y ACADÉMICOS ---
    COLOR_PRIMARY = RGBColor(15, 23, 42)      # Deep Navy / Dark Slate #0F172A
    COLOR_SECONDARY = RGBColor(30, 41, 59)    # Slate #1E293B
    COLOR_GOLD = RGBColor(184, 134, 11)       # Spartan Dark Gold #B8860B
    COLOR_BRIGHT_GOLD = RGBColor(220, 160, 0) # Accent Gold #DCA000
    COLOR_BODY = RGBColor(51, 65, 85)         # Charcoal Slate #334155
    COLOR_MUTED = RGBColor(100, 116, 139)     # Gray Slate #64748B
    COLOR_GREEN = RGBColor(16, 149, 90)       # Emerald #10955A

    # --- ESTILO NORMAL ---
    normal_style = doc.styles['Normal']
    normal_style.font.name = 'Calibri'
    normal_style.font.size = Pt(10)
    normal_style.font.color.rgb = COLOR_BODY
    normal_style.paragraph_format.line_spacing = 1.15
    normal_style.paragraph_format.space_after = Pt(4)

    # Encabezado y Pie de página para páginas subsecuentes
    subsequent_section = doc.sections[0]
    header = subsequent_section.header
    header_p = header.paragraphs[0]
    header_p.alignment = WD_ALIGN_PARAGRAPH.RIGHT
    h_run1 = header_p.add_run("PROYECTO DE GRADO  |  SPARTAN SUPLEMENTOS BOLIVIA        ")
    h_run1.font.name = 'Calibri'
    h_run1.font.size = Pt(8.5)
    h_run1.font.color.rgb = COLOR_MUTED
    h_run2 = header_p.add_run("INFORME DE MOCKUPS & SISTEMA REAL EN PRODUCCIÓN")
    h_run2.font.name = 'Calibri'
    h_run2.font.size = Pt(8.5)
    h_run2.font.bold = True
    h_run2.font.color.rgb = COLOR_GOLD

    footer = subsequent_section.footer
    footer_p = footer.paragraphs[0]
    footer_p.alignment = WD_ALIGN_PARAGRAPH.RIGHT
    f_run1 = footer_p.add_run("Carrera de Ingeniería de Sistemas Informáticos  •  ")
    f_run1.font.name = 'Calibri'
    f_run1.font.size = Pt(8.5)
    f_run1.font.color.rgb = COLOR_MUTED
    f_run2 = footer_p.add_run("Página ")
    f_run2.font.name = 'Calibri'
    f_run2.font.size = Pt(8.5)
    f_run2.font.color.rgb = COLOR_MUTED
    add_page_number_field(f_run2)
    f_run3 = footer_p.add_run(" de ")
    f_run3.font.name = 'Calibri'
    f_run3.font.size = Pt(8.5)
    f_run3.font.color.rgb = COLOR_MUTED
    add_numpages_field(f_run3)

    # --- MÉTODOS DE ESCRITURA Y TIPOGRAFÍA ---
    def add_h1(text, icon=""):
        p = doc.add_paragraph()
        p.paragraph_format.space_before = Pt(16)
        p.paragraph_format.space_after = Pt(6)
        p.paragraph_format.keep_with_next = True
        run = p.add_run(f"{icon} {text}" if icon else text)
        run.font.name = 'Calibri'
        run.font.size = Pt(16)
        run.font.bold = True
        run.font.color.rgb = COLOR_PRIMARY
        pBrd = parse_xml(f'<w:pBrd {nsdecls("w")}><w:bottom w:val="single" w:sz="12" w:space="4" w:color="B8860B"/></w:pBrd>')
        p._p.get_or_add_pPr().append(pBrd)
        return p

    def add_h2(text):
        p = doc.add_paragraph()
        p.paragraph_format.space_before = Pt(12)
        p.paragraph_format.space_after = Pt(4)
        p.paragraph_format.keep_with_next = True
        run = p.add_run(text)
        run.font.name = 'Calibri'
        run.font.size = Pt(12.5)
        run.font.bold = True
        run.font.color.rgb = COLOR_SECONDARY
        return p

    def add_h3(text):
        p = doc.add_paragraph()
        p.paragraph_format.space_before = Pt(8)
        p.paragraph_format.space_after = Pt(2)
        p.paragraph_format.keep_with_next = True
        run = p.add_run(text)
        run.font.name = 'Calibri'
        run.font.size = Pt(11)
        run.font.bold = True
        run.font.color.rgb = COLOR_GOLD
        return p

    def add_p(text, bold_prefix="", italic_suffix=""):
        p = doc.add_paragraph()
        p.paragraph_format.space_after = Pt(4)
        p.paragraph_format.line_spacing = 1.15
        if bold_prefix:
            r_pre = p.add_run(bold_prefix)
            r_pre.font.name = 'Calibri'
            r_pre.font.bold = True
            r_pre.font.color.rgb = COLOR_PRIMARY
        r_txt = p.add_run(text)
        r_txt.font.name = 'Calibri'
        r_txt.font.color.rgb = COLOR_BODY
        if italic_suffix:
            r_suf = p.add_run(italic_suffix)
            r_suf.font.name = 'Calibri'
            r_suf.font.italic = True
            r_suf.font.color.rgb = COLOR_MUTED
        return p

    def add_bullet(bold_prefix, text):
        p = doc.add_paragraph(style='List Bullet')
        p.paragraph_format.space_after = Pt(2)
        p.paragraph_format.line_spacing = 1.15
        r_pre = p.add_run(bold_prefix)
        r_pre.font.name = 'Calibri'
        r_pre.font.bold = True
        r_pre.font.color.rgb = COLOR_PRIMARY
        r_txt = p.add_run(text)
        r_txt.font.name = 'Calibri'
        r_txt.font.color.rgb = COLOR_BODY
        return p

    def add_callout(title, items, border_color="B8860B", bg_color="F8FAFC"):
        table = doc.add_table(rows=1, cols=1)
        table.alignment = WD_TABLE_ALIGNMENT.CENTER
        cell = table.cell(0, 0)
        cell.width = Inches(7.0)
        set_cell_background(cell, bg_color)
        set_cell_margins(cell, top=100, bottom=100, left=180, right=140)
        set_cell_borders(cell, left=("single", "36", "0", border_color),
                               top=("none", "0", "0", "auto"),
                               bottom=("none", "0", "0", "auto"),
                               right=("none", "0", "0", "auto"))
        
        p = cell.paragraphs[0]
        p.paragraph_format.space_after = Pt(3)
        r_t = p.add_run(title)
        r_t.font.name = 'Calibri'
        r_t.font.bold = True
        r_t.font.size = Pt(10.5)
        r_t.font.color.rgb = COLOR_PRIMARY

        for it_title, it_val in items:
            pi = cell.add_paragraph()
            pi.paragraph_format.space_after = Pt(2)
            pi.paragraph_format.line_spacing = 1.1
            rt = pi.add_run(f"• {it_title}: ")
            rt.font.name = 'Calibri'
            rt.font.bold = True
            rt.font.size = Pt(9.5)
            rt.font.color.rgb = COLOR_GOLD if border_color == "B8860B" else (COLOR_GREEN if border_color == "10955A" else COLOR_SECONDARY)
            rv = pi.add_run(it_val)
            rv.font.name = 'Calibri'
            rv.font.size = Pt(9.5)
            rv.font.color.rgb = COLOR_BODY
        
        sp = doc.add_paragraph()
        sp.paragraph_format.space_before = Pt(2)
        sp.paragraph_format.space_after = Pt(2)

    def insert_image_pair(web_img_name, movil_img_name, web_caption, movil_caption):
        comp_table = doc.add_table(rows=1, cols=2)
        comp_table.alignment = WD_TABLE_ALIGNMENT.CENTER
        
        c_web = comp_table.cell(0, 0)
        c_mov = comp_table.cell(0, 1)
        c_web.width = Inches(4.7)
        c_mov.width = Inches(2.3)

        set_cell_background(c_web, "0F172A")
        set_cell_background(c_mov, "0F172A")
        set_cell_margins(c_web, top=100, bottom=100, left=100, right=80)
        set_cell_margins(c_mov, top=100, bottom=100, left=80, right=100)
        set_cell_borders(c_web, top=("single", "12", "0", "B8860B"),
                                bottom=("single", "12", "0", "B8860B"),
                                left=("single", "6", "0", "334155"),
                                right=("single", "6", "0", "334155"))
        set_cell_borders(c_mov, top=("single", "12", "0", "B8860B"),
                                bottom=("single", "12", "0", "B8860B"),
                                left=("single", "6", "0", "334155"),
                                right=("single", "6", "0", "334155"))

        # Imagen Web
        web_path = os.path.join(capturas_dir, web_img_name)
        p_w = c_web.paragraphs[0]
        p_w.alignment = WD_ALIGN_PARAGRAPH.CENTER
        p_w.paragraph_format.space_after = Pt(4)
        if os.path.exists(web_path):
            r_w_img = p_w.add_run()
            r_w_img.add_picture(web_path, width=Inches(4.45))
        
        p_w_cap = c_web.add_paragraph()
        p_w_cap.alignment = WD_ALIGN_PARAGRAPH.CENTER
        p_w_cap.paragraph_format.space_after = Pt(2)
        rw_lbl = p_w_cap.add_run(web_caption + "\n")
        rw_lbl.font.name = 'Calibri'
        rw_lbl.font.size = Pt(8.5)
        rw_lbl.font.bold = True
        rw_lbl.font.color.rgb = COLOR_BRIGHT_GOLD
        rw_sub = p_w_cap.add_run("Resolución Desktop 1440x900 px")
        rw_sub.font.name = 'Calibri'
        rw_sub.font.size = Pt(7.5)
        rw_sub.font.color.rgb = RGBColor(148, 163, 184)

        # Imagen Móvil
        mov_path = os.path.join(capturas_dir, movil_img_name)
        p_m = c_mov.paragraphs[0]
        p_m.alignment = WD_ALIGN_PARAGRAPH.CENTER
        p_m.paragraph_format.space_after = Pt(4)
        if os.path.exists(mov_path):
            r_m_img = p_m.add_run()
            r_m_img.add_picture(mov_path, width=Inches(2.1))
        
        p_m_cap = c_mov.add_paragraph()
        p_m_cap.alignment = WD_ALIGN_PARAGRAPH.CENTER
        p_m_cap.paragraph_format.space_after = Pt(2)
        rm_lbl = p_m_cap.add_run(movil_caption + "\n")
        rm_lbl.font.name = 'Calibri'
        rm_lbl.font.size = Pt(8.5)
        rm_lbl.font.bold = True
        rm_lbl.font.color.rgb = COLOR_BRIGHT_GOLD
        rm_sub = p_m_cap.add_run("Resolución Smartphone 390x844 px")
        rm_sub.font.name = 'Calibri'
        rm_sub.font.size = Pt(7.5)
        rm_sub.font.color.rgb = RGBColor(148, 163, 184)

        sp = doc.add_paragraph()
        sp.paragraph_format.space_before = Pt(3)
        sp.paragraph_format.space_after = Pt(3)

    # =========================================================================
    # 1. CARÁTULA ACADÉMICA FORMAL (COVER PAGE)
    # =========================================================================
    p_cov_top = doc.add_paragraph()
    p_cov_top.paragraph_format.space_before = Pt(25)
    p_cov_top.paragraph_format.space_after = Pt(6)
    p_cov_top.alignment = WD_ALIGN_PARAGRAPH.CENTER
    r_inst = p_cov_top.add_run("CARRERA DE INGENIERÍA DE SISTEMAS INFORMÁTICOS\nPROYECTO DE GRADO  •  MODALIDAD TESIS / TRABAJO DIRIGIDO")
    r_inst.font.name = 'Calibri'
    r_inst.font.size = Pt(11)
    r_inst.font.bold = True
    r_inst.font.color.rgb = COLOR_MUTED

    p_sep = doc.add_paragraph()
    p_sep.alignment = WD_ALIGN_PARAGRAPH.CENTER
    p_sep.paragraph_format.space_before = Pt(8)
    p_sep.paragraph_format.space_after = Pt(22)
    r_line = p_sep.add_run("━" * 45)
    r_line.font.name = 'Calibri'
    r_line.font.bold = True
    r_line.font.color.rgb = COLOR_GOLD

    p_title = doc.add_paragraph()
    p_title.alignment = WD_ALIGN_PARAGRAPH.CENTER
    p_title.paragraph_format.space_after = Pt(14)
    r_t1 = p_title.add_run("INFORME TÉCNICO INTEGRAL DE MOCKUPS, DECISIONES DE DISEÑO Y EVIDENCIA DEL SISTEMA REAL EN PRODUCCIÓN")
    r_t1.font.name = 'Calibri'
    r_t1.font.size = Pt(21)
    r_t1.font.bold = True
    r_t1.font.color.rgb = COLOR_PRIMARY

    p_sub = doc.add_paragraph()
    p_sub.alignment = WD_ALIGN_PARAGRAPH.CENTER
    p_sub.paragraph_format.space_after = Pt(32)
    r_sub = p_sub.add_run("Plataforma Inteligente de Evaluación Biométrica 3D (MediaPipe Pose),\nClasificación Antropométrica (Random Forest), Prescripción Nutricional,\nDashboard Predictivo de Demanda y ERP Transaccional con Kárdex ACID")
    r_sub.font.name = 'Calibri'
    r_sub.font.size = Pt(11.5)
    r_sub.font.italic = True
    r_sub.font.color.rgb = COLOR_GOLD

    rubric_tbl = doc.add_table(rows=1, cols=3)
    rubric_tbl.alignment = WD_TABLE_ALIGNMENT.CENTER
    cols_data = [
        ("Claridad Funcional", "35%", "Demostración en Vivo"),
        ("Decisiones de Diseño", "35%", "Ergonomía & WCAG"),
        ("Cobertura Web & Móvil", "30%", "Simetría Responsive")
    ]
    for i, (crit, pct, sub) in enumerate(cols_data):
        c = rubric_tbl.cell(0, i)
        c.width = Inches(2.25)
        set_cell_background(c, "0F172A")
        set_cell_margins(c, top=140, bottom=140, left=100, right=100)
        set_cell_borders(c, top=("single", "12", "0", "B8860B"),
                            bottom=("single", "12", "0", "B8860B"),
                            left=("single", "6", "0", "334155"),
                            right=("single", "6", "0", "334155"))
        p = c.paragraphs[0]
        p.alignment = WD_ALIGN_PARAGRAPH.CENTER
        p.paragraph_format.space_after = Pt(2)
        r_pct = p.add_run(pct)
        r_pct.font.name = 'Calibri'
        r_pct.font.size = Pt(16)
        r_pct.font.bold = True
        r_pct.font.color.rgb = COLOR_BRIGHT_GOLD
        
        p2 = c.add_paragraph()
        p2.alignment = WD_ALIGN_PARAGRAPH.CENTER
        p2.paragraph_format.space_after = Pt(1)
        r_cr = p2.add_run(crit)
        r_cr.font.name = 'Calibri'
        r_cr.font.size = Pt(9.5)
        r_cr.font.bold = True
        r_cr.font.color.rgb = RGBColor(255, 255, 255)

        p3 = c.add_paragraph()
        p3.alignment = WD_ALIGN_PARAGRAPH.CENTER
        r_sb = p3.add_run(sub)
        r_sb.font.name = 'Calibri'
        r_sb.font.size = Pt(8.5)
        r_sb.font.color.rgb = RGBColor(148, 163, 184)

    p_meta = doc.add_paragraph()
    p_meta.paragraph_format.space_before = Pt(75)
    p_meta.paragraph_format.space_after = Pt(2)
    p_meta.alignment = WD_ALIGN_PARAGRAPH.CENTER
    r_org = p_meta.add_run("Organización Contraparte: ")
    r_org.font.bold = True
    r_org.font.color.rgb = COLOR_PRIMARY
    r_org2 = p_meta.add_run("Spartan Suplementos Bolivia\n")
    r_org2.font.color.rgb = COLOR_BODY
    r_doc = p_meta.add_run("Documento Oficial de Evaluación Académica y Defensa Técnica\n")
    r_doc.font.color.rgb = COLOR_MUTED
    r_date = p_meta.add_run("La Paz • Bolivia — Octubre 2026")
    r_date.font.bold = True
    r_date.font.color.rgb = COLOR_GOLD

    doc.add_page_break()

    # =========================================================================
    # 2. ÍNDICE GENERAL / TABLA DE CONTENIDOS FORMAL
    # =========================================================================
    add_h1("TABLA DE CONTENIDO Y ESTRUCTURA DEL INFORME", "📋")
    add_p("A continuación se presenta el desglose temático del informe técnico unificado, articulado conforme a los estándares académicos de la Carrera de Ingeniería de Sistemas y a la rúbrica de evaluación sobre 100 puntos:")

    toc_items = [
        ("1. Resumen Ejecutivo y Verificación del Entorno en Ejecución Real", "Arquitectura contenerizada, puertos activos, endpoints REST y estado transaccional"),
        ("2. Rúbrica y Criterios de Evaluación Académica (100 Puntos)", "Desglose formal: Claridad Funcional (35%), Diseño y Usabilidad (35%), Cobertura Web/Móvil (30%)"),
        ("3. Explicación Profunda de Decisiones de Diseño y Usabilidad (35%)", "Ergonomía, Ley de Fitts, Thumb Zone, Accesibilidad WCAG 2.1 AAA, Dark Mode y Progressive Disclosure"),
        ("4. Cobertura de Plataformas: Matriz Comparativa Web vs. Móvil (30%)", "Matriz técnica exhaustiva de los 8 módulos del sistema (1440x900 px vs. 390x844 px)"),
        ("5. Evidencia de Pantallas Reales del Sistema y Flujos de Interacción (35%)", "Inspección fotográfica de alta resolución, flujos de usuario y telemetría de producción"),
        ("    5.1. Módulo de Biometría & Escáner Articular 3D con IA", "33 landmarks MediaPipe Pose, somatotipo Random Forest 100%, postura sagital e IMC"),
        ("    5.2. Punto de Venta (POS) y Facturación con Kárdex en Vivo", "Terminal rápida, Row-Level Locking, 2 ítems en orden (Bs. 405.00) y alerta Sonner"),
        ("    5.3. Dashboard Predictivo de Ventas con Machine Learning", "1,397 transacciones históricas (LPZ/SCZ), R²=0.6184, proyección quincenal y banda al 95%"),
        ("    5.4. Catálogo Comercial de Productos y Vitrina Digital", "198 productos en inventario, precios oficiales en Bolivianos (Bs.) y filtros rápidos"),
        ("    5.5. Prescripción Nutricional, Rutina y Cross-Selling IA", "Inferencia explicable CART, Reglas de afinidad CART-1 y CART-4, stock garantizado"),
        ("    5.6. Diagnóstico Antropométrico, Telemetría y Planes Nutricionales", "Gasto energético basal/activo, macronutrientes, V-Taper y latencia de inferencia"),
        ("    5.7. Directorio Administrativo de Clientes y Expedientes", "Auditoría de perfiles clínicos, estados de verificación médica y conversión de ventas"),
        ("    5.8. Autenticación, Seguridad y Control de Acceso (RBAC)", "Tokens asimétricos JWT, hashing Bcrypt con sal, roles administrativos y adaptación táctil"),
        ("6. Auditoría de Calidad Técnica, Seguridad y Arquitectura de Datos", "Aislamiento en esquemas PostgreSQL (erp, ia, parametros) y cero bloqueo cruzado"),
        ("7. Conclusiones y Cumplimiento de la Rúbrica Académica", "Dictamen de cumplimiento al 100% en los tres ejes evaluativos"),
        ("8. Glosario Técnico de Términos de Ingeniería", "Definiciones formales de MediaPipe, Kárdex ACID, Fitts, Heath-Carter y CART")
    ]

    toc_table = doc.add_table(rows=len(toc_items), cols=2)
    toc_table.alignment = WD_TABLE_ALIGNMENT.CENTER
    for idx, (cap, desc) in enumerate(toc_items):
        c1 = toc_table.cell(idx, 0)
        c2 = toc_table.cell(idx, 1)
        c1.width = Inches(3.8)
        c2.width = Inches(3.2)
        set_cell_background(c1, "F8FAFC" if idx % 2 == 0 else "FFFFFF")
        set_cell_background(c2, "F8FAFC" if idx % 2 == 0 else "FFFFFF")
        set_cell_margins(c1, top=60, bottom=60, left=100, right=80)
        set_cell_margins(c2, top=60, bottom=60, left=80, right=100)
        set_cell_borders(c1, bottom=("single", "4", "0", "E2E8F0"))
        set_cell_borders(c2, bottom=("single", "4", "0", "E2E8F0"))

        p1 = c1.paragraphs[0]
        p1.paragraph_format.space_after = Pt(1)
        r1 = p1.add_run(cap)
        r1.font.name = 'Calibri'
        r1.font.size = Pt(9.5)
        if not cap.startswith("    "):
            r1.font.bold = True
            r1.font.color.rgb = COLOR_PRIMARY
        else:
            r1.font.color.rgb = COLOR_SECONDARY

        p2 = c2.paragraphs[0]
        p2.paragraph_format.space_after = Pt(1)
        r2 = p2.add_run(desc)
