# Base de datos PostgreSQL (driver asyncpg para FastAPI)
DATABASE_URL=postgresql+asyncpg://postgres:tu_contrasena@localhost:5432/spartan_db
ENVIRONMENT=development

# OAuth2 y JWT. Genera una clave aleatoria de al menos 32 caracteres.
SECRET_KEY=genera_una_clave_segura_de_32_caracteres_o_mas
ACCESS_TOKEN_EXPIRE_MINUTES=30
ALGORITHM=HS256

# Credencial inicial de aprovisionamiento
ADMIN_INITIAL_PASSWORD=cambia_esta_contrasena_admin

# Integraciones de IA
ROBOFLOW_API_KEY=tu_api_key_de_roboflow
IA_SERVICE_URL=http://localhost:8001
IA_INTERNAL_API_KEY=genera_otra_clave_aleatoria_de_32_caracteres_o_mas

# Solo para desarrollo local; nunca habilitar en produccion.
EMAIL_DEBUG_CODES=False
